/* TimeOS Control - Dark Engineering Theme */

/* === Global === */
QWidget {
    background-color: #1a1a1a;
    color: #e0e0e0;
    font-family: "Monospace", "Consolas", "Courier New";
    font-size: 10pt;
}

QMainWindow {
    background-color: #0d0d0d;
}

/* === Frames and Groups === */
QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #00ff88;
}

QFrame {
    border: none;
}

QFrame[frameShape="4"] { /* HLine */
    border: none;
    border-top: 1px solid #3a3a3a;
    max-height: 1px;
}

QFrame[frameShape="5"] { /* VLine */
    border: none;
    border-left: 1px solid #3a3a3a;
    max-width: 1px;
}

/* === Buttons === */
QPushButton {
    background-color: #2a2a2a;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 8px 16px;
    min-width: 80px;
    color: #e0e0e0;
}

QPushButton:hover {
    background-color: #3a3a3a;
    border-color: #00ff88;
}

QPushButton:pressed {
    background-color: #1a1a1a;
}

QPushButton:disabled {
    background-color: #1a1a1a;
    color: #5a5a5a;
    border-color: #2a2a2a;
}

/* Primary action button */
QPushButton[primary="true"] {
    background-color: #004d40;
    border-color: #00ff88;
    color: #00ff88;
}

QPushButton[primary="true"]:hover {
    background-color: #006050;
}

/* Danger button (E-Stop) */
QPushButton[danger="true"] {
    background-color: #4a0000;
    border: 2px solid #ff4444;
    color: #ff4444;
    font-weight: bold;
}

QPushButton[danger="true"]:hover {
    background-color: #6a0000;
    border-color: #ff6666;
}

/* === Input Fields === */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0d0d0d;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    padding: 6px;
    color: #00ff88;
    selection-background-color: #004d40;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #00ff88;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #1a1a1a;
    color: #5a5a5a;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    border: 2px solid #00ff88;
    border-top: none;
    border-left: none;
    width: 6px;
    height: 6px;
    transform: rotate(45deg);
}

QComboBox QAbstractItemView {
    background-color: #1a1a1a;
    border: 1px solid #3a3a3a;
    selection-background-color: #004d40;
}

/* === Labels === */
QLabel {
    color: #e0e0e0;
    background: transparent;
}

QLabel[heading="true"] {
    font-size: 12pt;
    font-weight: bold;
    color: #00ff88;
}

QLabel[value="true"] {
    font-family: "Monospace";
    color: #00ff88;
}

QLabel[warning="true"] {
    color: #ffaa00;
}

QLabel[error="true"] {
    color: #ff4444;
}

/* === Scroll Areas === */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background-color: #1a1a1a;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3a3a3a;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a4a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #1a1a1a;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3a3a3a;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a4a4a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Text Areas === */
QTextEdit, QPlainTextEdit {
    background-color: #0d0d0d;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    color: #e0e0e0;
    font-family: "Monospace";
}

/* === Progress Bars === */
QProgressBar {
    background-color: #0d0d0d;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    text-align: center;
    color: #e0e0e0;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #00ff88;
    border-radius: 2px;
}

/* === Sliders === */
QSlider::groove:horizontal {
    background-color: #0d0d0d;
    border: 1px solid #3a3a3a;
    height: 8px;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #00ff88;
    border: none;
    width: 16px;
    margin: -4px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #00ffaa;
}

/* === Tab Widget === */
QTabWidget::pane {
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    padding: 4px;
}

QTabBar::tab {
    background-color: #1a1a1a;
    border: 1px solid #3a3a3a;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #2a2a2a;
    border-color: #00ff88;
    color: #00ff88;
}

QTabBar::tab:hover:!selected {
    background-color: #2a2a2a;
}

/* === Dialogs === */
QDialog {
    background-color: #1a1a1a;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* === Menu Bar === */
QMenuBar {
    background-color: #0d0d0d;
    border-bottom: 1px solid #3a3a3a;
    padding: 2px;
}

QMenuBar::item {
    padding: 4px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2a2a2a;
}

QMenu {
    background-color: #1a1a1a;
    border: 1px solid #3a3a3a;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #004d40;
}

QMenu::separator {
    height: 1px;
    background-color: #3a3a3a;
    margin: 4px 8px;
}

/* === Status Bar === */
QStatusBar {
    background-color: #0d0d0d;
    border-top: 1px solid #3a3a3a;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* === Tooltips === */
QToolTip {
    background-color: #2a2a2a;
    border: 1px solid #00ff88;
    color: #e0e0e0;
    padding: 4px;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #3a3a3a;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #00ff88;
}
