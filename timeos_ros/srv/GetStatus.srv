# GetStatus.srv - Get system or module status
#
# Request current status of the system or a specific module.

# Module to query (empty = system overview)
# Options: "field_generator", "tdu", "causality", "safety", "thermal"
string module

# Whether to include detailed diagnostics
bool include_diagnostics true

---
# Response

# Overall system state
string system_state

# Module-specific status
string module_state

# Whether system is safe to operate
bool safe_to_operate

# Active faults
string[] faults

# Active warnings
string[] warnings

# Key-value pairs for detailed status
string[] status_keys
string[] status_values

# Timestamp of status
float64 timestamp
