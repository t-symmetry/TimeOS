# ValidateCausality.srv - Validate causality constraints
#
# Check if a proposed event or action would violate causality.

# Event to validate (optional - for checking proposed events)
timeos_msgs/TimelineEvent proposed_event

# Or specify just the temporal parameters
float64 proposed_t
string proposed_frame_id
string[] proposed_parents

# Constraint types to check (empty = all)
string[] constraint_types

# Whether to compute detailed violation report
bool detailed_report true

---
# Response

# Overall result: true if causality is preserved
bool valid

# Risk level (0.0-1.0)
float64 risk_level

# Violated constraints
string[] violated_constraints

# Constraint check results
string[] check_names
bool[] check_passed
string[] check_messages
float64[] check_risk_contributions

# Light cone analysis (if applicable)
bool in_future_light_cone
bool in_past_light_cone
float64 spacetime_interval

# Error message if validation failed
string error_message
