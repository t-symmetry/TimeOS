# SetField.srv - Set field generator target
#
# Request to change the magnetic field target.

# Target field strength (Tesla)
float64 target_tesla

# Ramp rate (Tesla/second, 0 = use default)
float64 ramp_rate 0.0

# Whether to wait for ramp completion
bool wait_for_completion false

# Timeout for completion (seconds, 0 = no timeout)
float64 timeout 0.0

---
# Response

# Whether command was accepted
bool accepted

# Current field strength at response time
float64 current_tesla

# Estimated time to reach target (seconds)
float64 estimated_duration

# Ramp state: "idle", "ramping_up", "ramping_down", "holding"
string ramp_state

# Error message if rejected
string error_message
